# SENTRA SOC Console — Frontend Environment Configuration
# =========================================================
# Copy this file to .env for local development.
# In production (Render), VITE_API_BASE_URL is set as a Render environment
# variable on the sentra-frontend static site service — do NOT commit .env.

# Backend API Base URL
# --------------------
# Local development (point at locally running FastAPI):
#   VITE_API_BASE_URL=http://localhost:8000
#
# Cloud / Production (Render Web Service, Railway, Fly.io, etc.):
#   VITE_API_BASE_URL=https://sentra-backend-zy7w.onrender.com
#
# Same-origin / reverse-proxy (frontend and API served from same domain):
#   Leave blank — all requests will use a relative /api path.
#
# This variable is baked into the JS bundle at Vite build time.
# The production value is set in .env.production (committed, no secrets).
VITE_API_BASE_URL=http://localhost:8000
