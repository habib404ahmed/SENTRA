# SENTRA Production Environment Configuration
# This file is read by Vite at build time for production builds.
# VITE_ prefixed variables are embedded directly into the compiled JS bundle.
# This file does NOT contain secrets — only the public API base URL.

# Backend API URL — full HTTPS URL of the deployed Render FastAPI service.
# This is the authoritative fallback when Render's fromService env injection
# returns only the bare hostname (sentra-backend-zy7w) without .onrender.com.
VITE_API_BASE_URL=https://sentra-backend-zy7w.onrender.com
