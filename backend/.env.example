# SENTRA Threat Defense Platform - Backend Environment Configuration
# ===================================================================

# PostgreSQL Database Connection URL
# - Local PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://postgres:sentra123@localhost:5432/sentra
# - Cloud PostgreSQL (Supabase / Neon / Render / AWS RDS / Railway):
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require
# Note: URLs starting with postgres:// or postgresql:// are automatically normalized to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/sentra

# Allowed CORS Origins (comma-separated, without trailing slashes)
# In production, specify the hosted frontend domain(s):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://sentra.yourdomain.com

# Optional regex pattern for CORS matching (e.g. for Vercel/Netlify preview deployments):
# CORS_ORIGIN_REGEX=^https:\/\/sentra.*\.vercel\.app$

# Network Binding (Auto-injected by most PaaS providers like Render, Railway, Heroku)
PORT=8000
HOST=0.0.0.0

# Environment mode: development, staging, or production
ENVIRONMENT=development

# Enable or disable interactive OpenAPI Swagger docs (/docs and /redoc)
DOCS_ENABLED=true

# Maximum allowed upload size for PCAP files (bytes, default 100MB)
MAX_UPLOAD_SIZE_BYTES=104857600
