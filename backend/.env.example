# SENTRA Threat Defense Platform — Backend Environment Configuration
# ===================================================================
# Copy this file to backend/.env for local development.
# In production (Render), all values are injected as Render environment
# variables — never commit backend/.env with real credentials.

# ── PostgreSQL Database ────────────────────────────────────────────────────────
# Local development (requires a local PostgreSQL instance):
#   DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/sentra
#
# Cloud / Production — use the connection string from your hosted provider:
#   Render PostgreSQL: injected automatically via fromDatabase in render.yaml
#   Neon / Supabase / Railway / AWS RDS:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require
#
# Note: URLs starting with postgres:// or postgresql:// are automatically
#       normalized to postgresql+psycopg:// by app/config.py.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/sentra

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes).
# In production, add the exact deployed frontend URL:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://sentra-frontend-5u9x.onrender.com

# Optional regex to match additional origins (e.g. preview deployments):
# CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.onrender\.com$

# ── Network Binding ────────────────────────────────────────────────────────────
# HOST and PORT are auto-injected by PaaS providers (Render, Railway, Heroku).
# Override only for local development.
PORT=8000
HOST=0.0.0.0

# ── Environment Mode ──────────────────────────────────────────────────────────
# Values: development | staging | production
ENVIRONMENT=development

# ── API Documentation ─────────────────────────────────────────────────────────
# Enable/disable /docs and /redoc Swagger UI.
# Keep true for development and SIH prototype. Set false for locked-down prod.
DOCS_ENABLED=true

# ── Upload Limits ─────────────────────────────────────────────────────────────
# Maximum PCAP upload size in bytes (default: 100 MB)
MAX_UPLOAD_SIZE_BYTES=104857600
